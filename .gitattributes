# Canonical bytes for protocol and provenance text, including Windows checkouts.
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
requirements*.txt text eol=lf
*.in text eol=lf
# Tracked CSVs are hashed in the spike reports, so their bytes must not depend on autocrlf.
*.csv text eol=lf
*.npz binary
*.png binary
.gitattributes text eol=lf
.gitignore text eol=lf
