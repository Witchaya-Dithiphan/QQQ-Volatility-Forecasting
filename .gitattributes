# Canonical bytes for protocol and provenance text, including Windows checkouts.
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
requirements*.txt text eol=lf
*.in text eol=lf
# Tracked CSVs are hashed in the spike reports, so their bytes must not depend on autocrlf.
*.csv text eol=lf
# The raw snapshot is hashed in its manifest with the CRLF bytes Nasdaq delivered; store it untouched.
data/raw/qqq_daily.csv -text
*.npz binary
*.png binary
.gitattributes text eol=lf
.gitignore text eol=lf
# Office and PDF deliverables are binary; never normalise or diff them as text.
*.docx binary
*.pptx binary
*.pdf binary
*.js text eol=lf
*.ps1 text eol=lf
