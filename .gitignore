# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and local secrets
.env
.env.*
!.env.example
*.pem
*.key

# Jupyter
.ipynb_checkpoints/
.jupyter/

# Data generated or downloaded by the pipeline
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
# The immutable snapshot cannot be re-downloaded (Nasdaq serves a rolling 10-year window).
!data/raw/qqq_daily.csv
!data/interim/.gitkeep
!data/processed/.gitkeep

# Generated outputs
#
# ผลโมเดล รายงาน และรูป = หลักฐานที่รายงานต้องอ้างอิง และทั้งสอง agent ต้องเห็นเพื่อทำ
# leaderboard กับ paired comparison A/B จึง commit ทั้งหมด — วัดแล้ว 38 runs รวม 1.08 MB
# (text 1.04 + binary .npz 0.04) ซึ่งเล็กเกินกว่าจะมีเหตุผลให้ซ่อน
#
# ที่ยังซ่อน: outputs/models/ กับ outputs/metrics/ เป็นโฟลเดอร์ร้างจากสถาปัตยกรรมเดิม
# ที่เลิกใช้แล้ว (ADR-001) ของจริงอยู่ใต้ outputs/modeling/
outputs/metrics/*
outputs/models/*
!outputs/metrics/.gitkeep
!outputs/models/.gitkeep

# Serialized models and large data artifacts
*.pkl
*.pickle
*.joblib
*.parquet
*.feather
*.h5
*.hdf5

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
tmp/
temp/

# IDE and editor settings
.idea/
.vscode/
*.code-workspace

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Local tooling
.tox/
.nox/
.cache/
.python-version
site/
.pytest_tmp/
